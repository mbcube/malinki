---
import { getEntry, getCollection } from "astro:content";
import { parsePublishedAt } from "@/lib/blog";

export function getStaticPaths() {
  return [
    { params: { lang: undefined } }, // French (default)
    { params: { lang: "en" } }, // English
  ];
}

const { lang } = Astro.params;
const currentLang = (lang || "fr") as "fr" | "en";
const { data: seo } = await getEntry("seo", currentLang);

const allPosts = await getCollection("blog");
const posts = allPosts
  .filter((p) => p.id.startsWith(`${currentLang}/`))
  .map((p) => p.data)
  .sort((a, b) => {
    const dateA = parsePublishedAt(a.publishedAt);
    const dateB = parsePublishedAt(b.publishedAt);
    if (!dateA || !dateB) return 0;
    return dateB.getTime() - dateA.getTime();
  });

import "@/styles/global.css";
import Header from "@/components/shared/Header.astro";
import Footer from "@/components/shared/Footer.astro";
import Metadata from "@/components/shared/Metadata.astro";
import BlogHero from "@/components/blog/BlogHero.astro";
import BlogGrid from "@/components/blog/BlogGrid.astro";
---

<html lang={currentLang} class="h-full">
  <head>
    <Metadata
      lang={currentLang}
      title={seo.blog_title}
      description={seo.blog_description}
      canonicalPath="/blog"
    />
  </head>
  <body class="min-h-full w-full font-['Montserrat'] bg-[#E6F5F7]">
    <Header lang={currentLang} />

    <main class="w-full flex flex-col min-h-screen 2xl:max-w-[1600px] mx-auto">
      <BlogHero lang={currentLang} />
      <BlogGrid posts={posts} lang={currentLang} />
    </main>

    <Footer />
  </body>
</html>
