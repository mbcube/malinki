---
import { getEntry, getCollection } from "astro:content";
import { parsePublishedAt, resolveCoverImageUrl } from "@/lib/blog";

export function getStaticPaths() {
  return [
    { params: { lang: undefined } }, // French (default)
    { params: { lang: "en" } }, // English
  ];
}

const { lang } = Astro.params;
const currentLang = (lang || "fr") as "fr" | "en";
const { data: seo } = (await getEntry("seo", currentLang))!;

const siteUrl = (Astro.site?.href || "https://malinki.ca").replace(/\/$/, "");
const blogPath = currentLang === "en" ? "/en/blog" : "/blog";
const blogUrl = `${siteUrl}${blogPath}`;
const rssUrl =
  currentLang === "en" ? `${siteUrl}/en/rss.xml` : `${siteUrl}/rss.xml`;

const allPosts = await getCollection("blog");
const posts = allPosts
  .filter((p) => p.id.startsWith(`${currentLang}/`) && !p.data.noIndex)
  .map((p) => p.data)
  .sort((a, b) => {
    const dateA = parsePublishedAt(a.publishedAt);
    const dateB = parsePublishedAt(b.publishedAt);
    if (!dateA || !dateB) return 0;
    return dateB.getTime() - dateA.getTime();
  });

const collectionLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: seo.blog_title,
  description: seo.blog_description,
  url: blogUrl,
  inLanguage: currentLang === "en" ? "en-CA" : "fr-CA",
  isPartOf: {
    "@type": "WebSite",
    name: "Malinki",
    url: siteUrl,
  },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: posts.length,
    itemListElement: posts.map((post, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${siteUrl}${currentLang === "en" ? "/en" : ""}/blog/${post.slug}`,
      name: post.title,
      ...(resolveCoverImageUrl(post.coverImage, siteUrl)
        ? { image: resolveCoverImageUrl(post.coverImage, siteUrl) }
        : {}),
    })),
  },
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Malinki",
      item: currentLang === "en" ? `${siteUrl}/en` : siteUrl,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: currentLang === "en" ? "Blog" : "Blogue",
      item: blogUrl,
    },
  ],
};

import "@/styles/global.css";
import Header from "@/components/shared/Header.astro";
import Footer from "@/components/shared/Footer.astro";
import Metadata from "@/components/shared/Metadata.astro";
import BlogHero from "@/components/blog/BlogHero.astro";
import BlogGrid from "@/components/blog/BlogGrid.astro";
---

<html lang={currentLang} class="h-full">
  <head>
    <Metadata
      lang={currentLang}
      title={seo.blog_title}
      description={seo.blog_description}
      canonicalPath="/blog"
      rssUrl={rssUrl}
      jsonLd={[collectionLd, breadcrumbLd]}
    />
  </head>
  <body class="min-h-full w-full font-['Montserrat'] bg-[#E6F5F7]">
    <Header lang={currentLang} />

    <main class="w-full flex flex-col min-h-screen 2xl:max-w-[1600px] mx-auto">
      <BlogHero lang={currentLang} />
      <BlogGrid posts={posts} lang={currentLang} />
    </main>

    <Footer />
  </body>
</html>
