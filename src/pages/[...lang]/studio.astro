---
import { useTranslations } from "../../i18n/utils";

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: "en" } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang || "fr") as "fr" | "en";
const t = useTranslations(currentLang);

const pageTitle = t("studio.title");

import "../../styles/global.css";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Metadata from "../../components/Metadata.astro";
import StudioHero from "../../components/studio/StudioHero.astro";
---

<html lang={currentLang} class="h-full">
  <head>
    <Metadata lang={currentLang} title={pageTitle} />
  </head>
  <body class="min-h-full w-full font-['Montserrat'] bg-[#E6F5F7]">
    <Header lang={currentLang} />

    <main class="w-full flex flex-col min-h-screen">
      <StudioHero lang={currentLang} />
      
      <!-- Additional studio sections will go here -->
    </main>

    <Footer />
  </body>
</html>
