                >
                  <svg
                    class="w-6 h-6 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold text-[#083e44] mb-2">
                    {t("contact.email_title")}
                  </h3>
                  <a
                    href="mailto:info@malinki.ca"
                    class="text-lg text-[#135560] hover:text-[#083e44] transition-colors"
                  >
                    info@malinki.ca
                  </a>
                </div>
              </div>
            </div> -->

            <!-- Phone Card -->
            <!-- <div
              class="bg-white rounded-2xl shadow-xl p-8 hover:shadow-2xl transition-shadow duration-300"
            >
              <div class="flex items-start space-x-4">
                <div
                  class="shrink-0 w-12 h-12 bg-[#083e44] rounded-full flex items-center justify-center"
                >
                  <svg
                    class="w-6 h-6 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold text-[#083e44] mb-2">
                    {t("contact.phone_title")}
                  </h3>
                  <a
                    href="tel:+15145551234"
                    class="text-lg text-[#135560] hover:text-[#083e44] transition-colors"
                  >
                    (514) 555-1234
                  </a>
                </div>
              </div>
            </div> -->

            <!-- Social Media Card -->
            <div
              class="bg-white rounded-2xl shadow-xl p-8 hover:shadow-2xl transition-shadow duration-300"
            >
              <div class="flex items-start space-x-4">
                <div
                  class="shrink-0 w-12 h-12 bg-[#083e44] rounded-full flex items-center justify-center overflow-hidden"
                >
                  <Image
                    src={agenceLogo}
                    alt="Instagram"
                    class="w-full h-full text-white"
                  />
                </div>
                <div>
                  <h3 class="text-xl font-bold text-[#083e44] mb-2">
                    {t("contact.agence_title")}
                  </h3>
                  <a
                    href="https://www.instagram.com/malinki.agence/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-lg text-[#135560] hover:text-[#083e44] transition-colors"
                  >
                    @malinki.agence
                  </a>
                </div>
              </div>
            </div>
            <div
              class="bg-white rounded-2xl shadow-xl p-8 hover:shadow-2xl transition-shadow duration-300"
            >
              <div class="flex items-start space-x-4">
                <div
                  class="shrink-0 w-12 h-12 bg-[#083e44] rounded-full flex items-center justify-center overflow-hidden"
                >
                  <Image
                    src={studioLogo}
                    alt="Instagram"
                    class="w-full h-full text-white"
                  />
                </div>
                <div>
                  <h3 class="text-xl font-bold text-[#083e44] mb-2">
                    {t("contact.studio_title")}
                  </h3>
                  <a
                    href="https://www.instagram.com/studio.malinki/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-lg text-[#135560] hover:text-[#083e44] transition-colors"
                  >
                    @studio.malinki
                  </a>
                </div>
              </div>
            </div>

            <!-- CTA Box -->
            <div
              class="bg-linear-to-br from-[#083e44] to-[#0a4d56] rounded-2xl shadow-xl p-8 text-white"
            >
              <h3 class="text-2xl font-bold mb-3">
                {t("contact.cta_title")}
              </h3>
              <p class="text-lg opacity-90">
                {t("contact.cta_text")}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <Footer />
  </body>
</html>
