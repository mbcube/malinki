---
import { useTranslations } from "../../i18n/utils";
import ContactForm from "../../components/ContactForm";
import agenceLogo from "../../images/agence-malinki.jpg";
import studioLogo from "../../images/studio-malinki.jpg";
import { Image } from "astro:assets";

export function getStaticPaths() {
  return [
    { params: { lang: undefined } }, // French (default)
    { params: { lang: "en" } }, // English
  ];
}

const { lang } = Astro.params;
const currentLang = (lang || "fr") as "fr" | "en";
const t = useTranslations(currentLang);

const pageTitle = t("contact.title");

// Props for ContactForm
const formLabels = {
  name: t("contact.name_label"),
  email: t("contact.email_label"),
  phone: t("contact.phone_label"),
  message: t("contact.message_label"),
  submit: t("contact.submit_button"),
  submitting: t("contact.submitting_button"),
};

const formPlaceholders = {
  name: t("contact.name_placeholder"),
  email: t("contact.email_placeholder"),
  phone: t("contact.phone_placeholder"),
  message: t("contact.message_placeholder"),
};

const formMessages = {
  success: t("contact.success_message"),
  error: t("contact.error_message"),
};

import "../../styles/global.css";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Metadata from "../../components/Metadata.astro";
---

<html lang={currentLang} class="h-full">
  <head>
    <Metadata lang={currentLang} title={pageTitle} />
  </head>
  <body class="min-h-full w-full font-['Montserrat'] bg-[#E6F5F7]">
    <Header lang={currentLang} />

    <div class="w-full flex flex-col 2xl:max-w-[1600px] mx-auto">
      <div
        class="mx-auto pt-20 lg:pt-32 pb-20 text-[#135560] px-6 lg:px-10"
        style="font-family: 'Rotunda Black', Montserrat, sans-serif;"
      >
        <!-- Hero Section -->
        <div
          class="max-w-4xl mx-auto text-center mb-16 animate__animated animate__fadeIn"
        >
          <h1
            class="text-5xl md:text-6xl lg:text-7xl font-bold text-[#083e44] mb-6 leading-tight"
          >
            {t("contact.heading")}
          </h1>
          <p
            class="text-lg md:text-xl lg:text-2xl text-[#083e44] font-medium max-w-2xl mx-auto"
          >
            {t("contact.subheading")}
          </p>
        </div>

        <!-- Contact Form & Info Grid -->
        <div
          class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16"
        >
          <!-- Contact Form -->
          <div
            class="bg-white rounded-2xl shadow-xl p-8 md:p-10 animate__animated animate__fadeInLeft"
          >
            <h2 class="text-2xl md:text-3xl font-bold text-[#083e44] mb-6">
              {t("contact.form_title")}
            </h2>

            <ContactForm
              client:load
              labels={formLabels}
              placeholders={formPlaceholders}
              messages={formMessages}
            />
          </div>

          <!-- Contact Info -->
          <div class="space-y-8 animate__animated animate__fadeInRight">
            <!-- Email Card -->
            <!-- <div
              class="bg-white rounded-2xl shadow-xl p-8 hover:shadow-2xl transition-shadow duration-300"
            >
              <div class="flex items-start space-x-4">
