---
import { getEntry } from "astro:content";

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const currentLang = (lang || "fr") as "fr" | "en";
const { data: seo } = await getEntry("seo", currentLang);

import "@/styles/global.css";
import Header from "@/components/shared/Header.astro";
import Footer from "@/components/shared/Footer.astro";
import HeroVideo from "@/components/landing/HeroVideo.astro";
import AboutText from "@/components/landing/AboutText.astro";
import ProjectsGrid from "@/components/landing/ProjectsGrid.astro";
import CtaSection from "@/components/landing/CtaSection.astro";
import ServicesSection from "@/components/landing/ServicesSection.astro";
import TeamSection from "@/components/landing/TeamSection.astro";
import LogosSection from "@/components/landing/LogosSection.astro";
import CtaSection2 from "@/components/landing/CtaSection2.astro";
import Metadata from "@/components/shared/Metadata.astro";
---

<html lang={currentLang} class="h-full">
  <head>
    <Metadata
      lang={currentLang}
      title={seo.home_title}
      description={seo.home_description}
      canonicalPath="/"
    />
  </head>
  <body class="min-h-full w-full font-['Montserrat'] bg-[#E6F5F7]">
    <Header lang={currentLang as "fr" | "en"} />
    <main class="px-6 w-full flex flex-col 2xl:max-w-[1600px] mx-auto">
      <HeroVideo />
      <AboutText />
      <ProjectsGrid lang={currentLang as "fr" | "en"} />
      <CtaSection />
      <ServicesSection />
      <TeamSection />
      <LogosSection />
      <CtaSection2 />
    </main>
  </body><Footer />
</html>
