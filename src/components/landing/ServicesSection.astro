---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import publicites from "@/images/Publicites.png";
import contenuDeMarque from "@/images/contenu-de-marque.png";
import contenuVertical from "@/images/contenu-vertical.png";
import videoclips from "@/images/videoclips.png";

const { lang } = Astro.params;
const currentLang = (lang || "fr") as "fr" | "en";
const { data: s } = await getEntry("sections", currentLang)!;
---

<!-- Services Section -->
<section
  class="relative w-full font-['Montserrat'] py-12 md:py-16 lg:py-20"
  data-section-type="services-section"
  id="services"
>
  <div class="w-full px-0 md:px-6 lg:px-8">
    <!-- Heading -->
    <div
      class="flex flex-col gap-6 items-center text-center mb-12 md:mb-16 lg:mb-20"
    >
      <h2
        class="font-bold text-[#083D45] text-[32px] sm:text-[36px] md:text-[44px] leading-none uppercase"
      >
        {s.services_heading}
      </h2>
    </div>

    <!-- Services List -->
    <div
      class="grid grid-cols-2 place-items-center gap-6 sm:gap-8 md:gap-8 lg:gap-12"
    >
      <a
        href={`/${currentLang === "fr" ? "" : "en/"}production-publicitaire`}
        class="group flex flex-col tablet:flex-row items-center justify-center tablet:justify-start gap-4 md:gap-6 tablet:gap-8 lg:gap-12"
      >
        <Image
          class="overflow-hidden rounded-lg flex-shrink-0 w-[170px] lg:w-[184px] h-[110px] lg:h-[120px] transition-all duration-200 ease-out hover:scale-[1.3] lg:hover:scale-[1.4] hover:-rotate-[4deg] hover:-translate-y-2 group-hover:scale-[1.3] lg:group-hover:scale-[1.4] group-hover:-rotate-[4deg] group-hover:-translate-y-2"
          loading="lazy"
          src={publicites}
          alt={s.service_1}
          width={1104}
          height={720}
        />
        <h3
          class="text-center tablet:text-left w-[14rem] tablet:w-[10rem] lg:w-[14rem] text-wrap font-bold text-[#083D45] text-[24px] sm:text-[28px] tablet:text-[20px] lg:text-[30px] leading-none uppercase transition-all duration-300 ease-out hover:scale-105 group-hover:scale-105"
        >
          {s.service_1}
        </h3>
      </a>

      <a
        href={`/${currentLang === "fr" ? "" : "en/"}video-clips`}
        class="group flex flex-col tablet:flex-row items-center justify-center tablet:justify-start gap-4 md:gap-6 tablet:gap-8 lg:gap-12"
      >
        <Image
          loading="lazy"
          class="overflow-hidden rounded-lg flex-shrink-0 w-[170px] lg:w-[184px] h-[110px] lg:h-[120px] transition-all duration-200 ease-out hover:scale-[1.3] lg:hover:scale-[1.4] hover:rotate-[4deg] hover:-translate-y-2 group-hover:scale-[1.3] lg:group-hover:scale-[1.4] group-hover:rotate-[4deg] group-hover:-translate-y-2"
          src={videoclips}
          alt={s.service_4}
          width={1104}
          height={720}
        />
        <h3
          class="text-center tablet:text-left w-[14rem] tablet:w-[10rem] lg:w-[14rem] text-wrap font-bold text-[#083D45] text-[24px] sm:text-[28px] tablet:text-[20px] lg:text-[30px] leading-none uppercase transition-all duration-300 ease-out hover:scale-105 group-hover:scale-105"
        >
          {s.service_4}
        </h3>
      </a>

      <a
        href={`/${currentLang === "fr" ? "" : "en/"}contenu-vertical`}
        class="group flex flex-col tablet:flex-row items-center justify-center tablet:justify-start gap-4 md:gap-6 tablet:gap-8 lg:gap-12"
      >
        <Image
          loading="lazy"
          class="overflow-hidden rounded-lg flex-shrink-0 w-[170px] lg:w-[184px] h-[110px] lg:h-[120px] transition-all duration-200 ease-out hover:scale-[1.3] lg:hover:scale-[1.4] hover:-rotate-[4deg] hover:-translate-y-2 group-hover:scale-[1.3] lg:group-hover:scale-[1.4] group-hover:-rotate-[4deg] group-hover:-translate-y-2"
          src={contenuVertical}
          alt={s.service_3}
          width={1104}
          height={720}
        />
        <h3
          class="text-center tablet:text-left min-h-[2rem] w-[14rem] tablet:w-[10rem] lg:w-[14rem] text-wrap font-bold text-[#083D45] text-[24px] sm:text-[28px] tablet:text-[20px] lg:text-[30px] leading-none uppercase transition-all duration-300 ease-out hover:scale-105 group-hover:scale-105"
        >
          {s.service_3}
        </h3>
      </a>

      <a
        href={`/${currentLang === "fr" ? "" : "en/"}contenu-de-marque`}
        class="group flex flex-col tablet:flex-row items-center justify-center tablet:justify-start gap-4 md:gap-6 tablet:gap-8 lg:gap-12"
      >
        <Image
          class="overflow-hidden rounded-lg flex-shrink-0 w-[170px] lg:w-[184px] h-[110px] lg:h-[120px] transition-all duration-200 ease-out hover:scale-[1.3] lg:hover:scale-[1.4] hover:rotate-[4deg] hover:-translate-y-2 group-hover:scale-[1.3] lg:group-hover:scale-[1.4] group-hover:rotate-[4deg] group-hover:-translate-y-2"
          loading="lazy"
          src={contenuDeMarque}
          alt={s.service_2}
          width={1104}
          height={720}
        />
        <h3
          class="text-center tablet:text-left min-h-[2rem] w-[14rem] tablet:w-[10rem] lg:w-[14rem] tracking-tightest text-wrap font-bold text-[#083D45] text-[24px] sm:text-[28px] tablet:text-[16px] tablet:text-[20px] lg:text-[30px] leading-none uppercase transition-all duration-300 ease-out hover:scale-105 group-hover:scale-105"
        >
          {s.service_2}
        </h3>
      </a>
    </div>
  </div>
</section>
