---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import { TeamMemberAccordion } from "@/components/landing/islands/TeamMemberAccordion";
import andrewTchernilevskii from "@/images/team/Andrew-Tchernilevskii.png";
import miroslavDufresne from "@/images/team/Miroslav-Dufresne_compressed.webp";
import jeremyLeblond from "@/images/team/Jeremy-Leblond.png";
import alexandreNormand from "@/images/team/alex-normand.png";
import cedricDemers from "@/images/team/cedric.png";
import justine from "@/images/team/justine.webp";

const { lang } = Astro.params;
const currentLang = (lang || "fr") as "fr" | "en";
const { data: s } = await getEntry("sections", currentLang);

const teamMembersRaw = [
  {
    id: "1",
    image: andrewTchernilevskii,
    hasSplitName: true,
    url: "https://www.linkedin.com/in/andrew-tchernilevskii-102496113/",
    nameLine1: s.team_member_1_name_line_1,
    nameLine2: s.team_member_1_name_line_2,
    name: "",
    role: s.team_member_1_role,
  },
  {
    id: "2",
    image: miroslavDufresne,
    hasSplitName: false,
    url: "https://www.linkedin.com/in/miroslav-dufresne-a5359863/",
    name: s.team_member_2_name,
    role: s.team_member_2_role,
  },
  {
    id: "3",
    image: jeremyLeblond,
    hasSplitName: false,
    url: "https://www.linkedin.com/in/j%C3%A9r%C3%A9my-leblond-0ab6a7153/",
    name: s.team_member_3_name,
    role: s.team_member_3_role,
  },
  {
    id: "6",
    image: justine,
    hasSplitName: false,
    url: "https://www.linkedin.com/in/justinegagnon/",
    name: s.team_member_6_name,
    role: s.team_member_6_role,
  },
  {
    id: "4",
    image: alexandreNormand,
    hasSplitName: false,
    url: "https://www.instagram.com/le.normand_alexandre/",
    name: s.team_member_4_name,
    role: s.team_member_4_role,
  },
  {
    id: "5",
    image: cedricDemers,
    hasSplitName: false,
    url: "https://www.linkedin.com/in/c%C3%A9dric-demers-891576250/",
    name: s.team_member_5_name,
    role: s.team_member_5_role,
  },
];

const teamMembersForReact = teamMembersRaw.map((m) => ({
  id: `member_${m.id}`,
  name: m.hasSplitName ? "" : m.name ?? "",
  nameLine1: m.hasSplitName ? m.nameLine1 : undefined,
  nameLine2: m.hasSplitName ? m.nameLine2 : undefined,
  role: m.role,
  imageUrl: m.image.src,
  linkedinUrl: m.url,
  hasSplitName: m.hasSplitName,
}));
---

<!-- Team Section -->
<section
  class="relative w-full font-['Montserrat'] py-12 md:py-16 lg:py-20"
  data-section-type="team-section"
  id="equipe"
>
  <div class="w-full px-4 md:px-6 lg:px-8">
    <!-- Heading -->
    <div
      data-reveal
      class="border-[#083D45] border-[0px_0px_1px] border-solid flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 lg:gap-0 pb-8 lg:pb-8 mb-0"
    >
      <div class="flex flex-col gap-4">
        <h2
          class="p-0 font-['Montserrat'] text-[2.75rem] sm:text-[3rem] md:text-[3.5rem] lg:text-[4rem] xl:text-[5rem] font-bold leading-none uppercase text-[#083D45]"
        >
          {s.team_mobile_heading}
        </h2>
        <p
          class="m-0 font-['Montserrat'] text-[18px] md:text-[20px] font-medium leading-[1.2] text-[#083D45] max-w-[291px] lg:max-w-[304px]"
        >
          {s.team_tagline}
        </p>
      </div>
    </div>

    <!-- Mobile: Accordion with LinkedIn Icons -->
    <div class="lg:hidden" data-reveal>
      <TeamMemberAccordion client:load members={teamMembersForReact} />
    </div>

    <!-- Desktop: Hover Effect with LinkedIn Links -->
    <div class="hidden lg:flex lg:flex-col w-full group">
      {
        teamMembersRaw.map((member) => (
          <a 
            href={member.url}
            target="_blank"
            rel="noopener noreferrer"
            data-reveal-item
            class="team-member group/member border-[#083D45] border-[0px_0px_1px] border-solid py-8 transition-opacity duration-200 ease-in-out relative group-hover:opacity-50 hover:opacity-100! block no-underline"
          >
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
              <div class="team-member-header cursor-pointer flex flex-col gap-4 pl-4 transition-transform duration-200 ease-in-out group-hover/member:translate-x-5">
                <h3 class="p-0 font-['Montserrat'] text-[24px] md:text-[32px] font-bold leading-none uppercase text-[#083D45]">
                  {member.hasSplitName ? (
                    <>
                      {member.nameLine1}
                      <br />
                      {member.nameLine2}
                    </>
                  ) : (
                    member.name
                  )}
                </h3>
                <p class="m-0 font-['Montserrat'] text-[16px] font-medium leading-[1.2] text-[#083D45]">
                  {member.role}
                </p>
              </div>

              <!-- Desktop Photo (Shows on Hover) -->
              <div class="flex items-center justify-end pr-4 absolute right-0 top-1/2 -translate-y-1/2 z-10 pointer-events-none">
                <Image
                  src={member.image}
                  alt={
                    member.hasSplitName
                      ? `${member.nameLine1} ${member.nameLine2}`
                      : member.name ?? ""
                  }
                  class="rounded-[32px] object-cover w-[384px] h-[480px] scale-0 group-hover/member:scale-100 transition-transform duration-200 ease-in-out origin-center"
                  loading="lazy"
                  width={1152}
                  height={1440}
                />
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const section = document.querySelector(
      '[data-section-type="team-section"]',
    );
    if (!section) return;

    const heading = section.querySelector<HTMLElement>("[data-reveal]");
    if (heading) {
      gsap.set(heading, { opacity: 0, y: 24 });
      ScrollTrigger.create({
        trigger: heading,
        start: "top 85%",
        once: true,
        onEnter: () => {
          gsap.to(heading, {
            opacity: 1,
            y: 0,
            duration: 0.6,
            ease: "power2.out",
          });
        },
      });
    }

    const items = section.querySelectorAll<HTMLElement>("[data-reveal-item]");
    if (items.length > 0) {
      gsap.set(items, { opacity: 0, y: 24 });
      ScrollTrigger.create({
        trigger: items[0].closest(".group") || section,
        start: "top 80%",
        once: true,
        onEnter: () => {
          gsap.to(items, {
            opacity: 1,
            y: 0,
            duration: 0.6,
            ease: "power2.out",
            stagger: 0.08,
          });
        },
      });
    }
  });
</script>

