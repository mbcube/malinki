---
import { useTranslations } from "../i18n/utils";
import { getImage } from "astro:assets";
import malinkiLogoBg from "../images/malinki-logo-bg.png";

const { lang, title } = Astro.props;
const currentLang = lang || "fr";

const siteUrl = Astro.site?.href || "https://malinki.pages.dev";
const currentUrl = `${siteUrl}${currentLang === "en" ? "/en" : ""}`;
const ogImage = await getImage({
  src: malinkiLogoBg,
  width: 1200,
  height: 630,
});
const ogImageUrl = new URL(ogImage.src, siteUrl).href;
---

<meta charset="utf-8" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="viewport" content="width=device-width" />

<!-- Preload critical fonts to prevent FOUT -->
<link
  rel="preload"
  href="/fonts/Montserrat-Medium.ttf"
  as="font"
  type="font/ttf"
  crossorigin
/>
<link
  rel="preload"
  href="/fonts/Montserrat-SemiBold.ttf"
  as="font"
  type="font/ttf"
  crossorigin
/>
<link
  rel="preload"
  href="/fonts/Montserrat-Bold.ttf"
  as="font"
  type="font/ttf"
  crossorigin
/>
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta
  name="description"
  content="Agence de production MALINKI - Production de vidéo créative, de publicités, contenu de marque, contenu vertical et vidéoclips."
/>

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={currentUrl} />
<meta property="og:title" content="Malinki" />
<meta
  property="og:description"
  content="Agence de production MALINKI - Production de vidéo créative, de publicités, contenu de marque, contenu vertical et vidéoclips."
/>
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={currentLang === "en" ? "en_US" : "fr_CA"} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={currentUrl} />
<meta name="twitter:title" content="Malinki" />
<meta
  name="twitter:description"
  content="Agence de production MALINKI - Production de vidéo créative, de publicités, contenu de marque, contenu vertical et vidéoclips."
/>
<meta name="twitter:image" content={ogImageUrl} />

<!-- Restore scroll position after language switch -->
<script is:inline>
  // Restore scroll position if saved from language switch
  (function () {
    const savedScrollPosition = sessionStorage.getItem("scrollPosition");
    if (savedScrollPosition !== null) {
      // Wait for page to load, then restore scroll position
      window.addEventListener("load", function () {
        window.scrollTo(0, parseInt(savedScrollPosition, 10));
        // Clear the saved position
        sessionStorage.removeItem("scrollPosition");
      });
    }
  })();
</script>
