---
import { getImage } from "astro:assets";
import malinkiLogoBg from "../images/malinki-logo-bg.png";

interface Props {
  lang: string;
  title: string;
  description: string;
  canonicalPath: string;
  ogImage?: ImageMetadata;
  type?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  lang,
  title,
  description,
  canonicalPath,
  ogImage: ogImageProp,
  type = "website",
  jsonLd,
} = Astro.props;

const currentLang = lang || "fr";
const siteUrl = (Astro.site?.href || "https://malinki.ca").replace(/\/$/, "");

const localePath = currentLang === "fr" ? canonicalPath : `/en${canonicalPath}`;
const canonicalUrl = `${siteUrl}${localePath === "/" ? "" : localePath}`;

const frPath = canonicalPath === "/" ? "" : canonicalPath;
const enPath = `/en${canonicalPath === "/" ? "" : canonicalPath}`;
const frUrl = `${siteUrl}${frPath}`;
const enUrl = `${siteUrl}${enPath}`;

const ogImageSource = ogImageProp || malinkiLogoBg;
const processedOgImage = await getImage({
  src: ogImageSource,
  width: 1200,
  height: 630,
});
const ogImageUrl = new URL(processedOgImage.src, siteUrl).href;

const organizationLd = {
  "@context": "https://schema.org",
  "@type": ["Organization", "LocalBusiness"],
  name: "Malinki",
  url: siteUrl,
  logo: new URL(
    (await getImage({ src: malinkiLogoBg, width: 600 })).src,
    siteUrl
  ).href,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Montréal",
    addressRegion: "QC",
    addressCountry: "CA",
  },
  areaServed: "Montréal",
  geo: {
    "@type": "GeoCoordinates",
    latitude: 45.5017,
    longitude: -73.5673,
  },
  sameAs: [
    "https://www.instagram.com/malinki.agence/",
    "https://www.instagram.com/studio.malinki/",
    "https://vimeo.com/malinkistudio",
  ],
};

const allJsonLd = jsonLd
  ? Array.isArray(jsonLd)
    ? [organizationLd, ...jsonLd]
    : [organizationLd, jsonLd]
  : [organizationLd];
---

<!-- Google Analytics -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-L066CRHY8F" is:inline></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-L066CRHY8F');
</script>

<meta charset="utf-8" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="viewport" content="width=device-width" />

<!-- Preload critical fonts to prevent FOUT -->
<link
  rel="preload"
  href="/fonts/Montserrat-Medium.ttf"
  as="font"
  type="font/ttf"
  crossorigin
/>
<link
  rel="preload"
  href="/fonts/Montserrat-SemiBold.ttf"
  as="font"
  type="font/ttf"
  crossorigin
/>
<link
  rel="preload"
  href="/fonts/Montserrat-Bold.ttf"
  as="font"
  type="font/ttf"
  crossorigin
/>

<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="description" content={description} />

<!-- Canonical & Hreflang -->
<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" hreflang="fr" href={frUrl} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="x-default" href={frUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content={currentLang === "en" ? "en_CA" : "fr_CA"} />
<meta
  property="og:locale:alternate"
  content={currentLang === "en" ? "fr_CA" : "en_CA"}
/>
<meta property="og:site_name" content="Malinki" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- JSON-LD Structured Data -->
{
  allJsonLd.map((ld) => (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(ld)}
    />
  ))
}

<!-- Restore scroll position after language switch -->
<script is:inline>
  (function () {
    var saved = sessionStorage.getItem("scrollPosition");
    if (saved !== null) {
      window.addEventListener("load", function () {
        window.scrollTo(0, parseInt(saved, 10));
        sessionStorage.removeItem("scrollPosition");
      });
    }
  })();
</script>
