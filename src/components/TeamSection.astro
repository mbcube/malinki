---
import { Image } from "astro:assets";
import { useTranslations } from "../i18n/utils";
import { TeamMemberAccordion } from "./TeamMemberAccordion";
import andrewTchernilevskii from "../images/Andrew-Tchernilevskii.png";
import miroslavDufresne from "../images/Miroslav-Dufresne_compressed.webp";
import jeremyLeblond from "../images/Jeremy-Leblond.png";

const { lang } = Astro.params;
const currentLang = (lang || "fr") as "fr" | "en";
const t = useTranslations(currentLang);

const teamMembers = [
  {
    id: "member_1",
    image: andrewTchernilevskii,
    hasSplitName: true,
    url: "https://www.linkedin.com/in/andrew-tchernilevskii-102496113/"
  },
  {
    id: "member_2",
    image: miroslavDufresne,
    hasSplitName: false,
    url: "https://www.linkedin.com/in/miroslav-dufresne-a5359863/"
  },
  {
    id: "member_3",
    image: jeremyLeblond,
    hasSplitName: true,
    url: "https://www.linkedin.com/in/j%C3%A9r%C3%A9my-leblond-0ab6a7153/"
  },
];

// Prepare data for React component
const teamMembersForReact = teamMembers.map((member) => ({
  id: member.id,
  name: member.hasSplitName ? "" : t(`sections.team.${member.id}.name`),
  nameLine1: member.hasSplitName ? t(`sections.team.${member.id}.name_line_1`) : undefined,
  nameLine2: member.hasSplitName ? t(`sections.team.${member.id}.name_line_2`) : undefined,
  role: t(`sections.team.${member.id}.role`),
  imageUrl: member.image.src,
  linkedinUrl: member.url,
  hasSplitName: member.hasSplitName,
}));
---

<!-- Team Section -->
<section
  class="relative w-full font-['Montserrat'] py-12 md:py-16 lg:py-20"
  data-section-type="team-section"
  id="equipe"
>
  <div class="w-full px-4 md:px-6 lg:px-8">
    <!-- Heading -->
    <div
      class="border-[#083D45] border-[0px_0px_1px] border-solid flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 lg:gap-0 pb-8 lg:pb-8 mb-0"
    >
      <!-- Mobile/Tablet: Single Heading -->
      <div class="flex flex-col gap-4 lg:hidden">
        <h2
          class="p-0 font-['Montserrat'] text-[44px] font-bold leading-none uppercase text-[#083D45]"
        >
          {t("sections.team.mobile_heading")}
        </h2>
        <p
          class="m-0 font-['Montserrat'] text-[18px] md:text-[20px] font-medium leading-[1.2] text-[#083D45] max-w-[291px]"
        >
          {t("sections.team.tagline")}
        </p>
      </div>

      <!-- Desktop: Split Heading -->
      <h2
        class="p-0 hidden lg:block font-['Montserrat'] text-[120px] font-bold leading-none uppercase text-[#083D45] shrink-0"
      >
        {t("sections.team.heading_left")}
      </h2>
      <p
        class="m-0 hidden lg:block font-['Montserrat'] text-[20px] font-medium leading-[1.2] text-[#083D45] text-center max-w-[304px]"
      >
        {t("sections.team.tagline")}
      </p>
      <h2
        class="p-0 hidden lg:block font-['Montserrat'] text-[120px] font-bold leading-none uppercase text-[#083D45] text-right shrink-0"
      >
        {t("sections.team.heading_right")}
      </h2>
    </div>

    <!-- Mobile: Accordion with LinkedIn Icons -->
    <div class="lg:hidden">
      <TeamMemberAccordion client:load members={teamMembersForReact} />
    </div>

    <!-- Desktop: Hover Effect with LinkedIn Links -->
    <div class="hidden lg:flex lg:flex-col w-full group">
      {
        teamMembers.map((member) => (
          <a 
            href={member.url}
            target="_blank"
            rel="noopener noreferrer"
            class="team-member group/member border-[#083D45] border-[0px_0px_1px] border-solid py-8 transition-opacity duration-200 ease-in-out relative group-hover:opacity-50 hover:opacity-100! block no-underline"
          >
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
              <div class="team-member-header cursor-pointer flex flex-col gap-4 pl-4 transition-transform duration-200 ease-in-out group-hover/member:translate-x-5">
                <h3 class="p-0 font-['Montserrat'] text-[24px] md:text-[32px] font-bold leading-none uppercase text-[#083D45]">
                  {member.hasSplitName ? (
                    <>
                      {t(`sections.team.${member.id}.name_line_1`)}
                      <br />
                      {t(`sections.team.${member.id}.name_line_2`)}
                    </>
                  ) : (
                    t(`sections.team.${member.id}.name`)
                  )}
                </h3>
                <p class="m-0 font-['Montserrat'] text-[16px] font-medium leading-[1.2] text-[#083D45]">
                  {t(`sections.team.${member.id}.role`)}
                </p>
              </div>

              <!-- Desktop Photo (Shows on Hover) -->
              <div class="flex items-center justify-end pr-4 absolute right-0 top-1/2 -translate-y-1/2 z-10 pointer-events-none">
                <Image
                  src={member.image}
                  alt={
                    member.hasSplitName
                      ? `${t(`sections.team.${member.id}.name_line_1`)} ${t(`sections.team.${member.id}.name_line_2`)}`
                      : t(`sections.team.${member.id}.name`)
                  }
                  class="rounded-[32px] object-cover w-[384px] h-[480px] scale-0 group-hover/member:scale-100 transition-transform duration-200 ease-in-out origin-center"
                  loading="lazy"
                  width={1152}
                  height={1440}
                />
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

