---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import malinkiLogo from "@/images/malinki-logo-c.png";
import studioLogo from "@/images/studio-malinki.jpg";
import LanguageSwitcher from "@/components/shared/islands/LanguageSwitcher";

const { lang } = Astro.params;
const currentLang = (lang || "fr") as "fr" | "en";
const { data: s } = await getEntry("sections", currentLang);
const currentPath = Astro.url.pathname;

// Inline settings (migrated from Shopify schema)
const settings = {
  instagram_url: "https://www.instagram.com/malinki.agence/",
  studio_instagram_url: "https://www.instagram.com/studio.malinki/",

};
---

<footer
  id="footer"
  class="flex-shrink-0 bg-[#083D45]! box-border p-[32px] w-full block!"
  data-section-type="footer-template"
>
  <div
    class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-[64px] lg:gap-0"
  >
    <!-- Logo -->
    <div class="flex flex-col items-center lg:items-start">
      <a href="/" class="tt-logo inline-block" itemprop="url">
        <Image
          src={malinkiLogo}
          alt="MALINKI"
          class="h-[80px]! w-[430px]! lg:h-[136px]! lg:w-auto! lg:max-w-[550px]! xl:max-w-[650px]! object-contain!"
          itemprop="logo"
          width={1290}
          height={240}
        />
      </a>
    </div>

    <!-- Social Icon + Language Switcher + Copyright -->
    <div
      class="flex flex-col gap-[32px] items-center lg:items-end justify-center"
    >
      <!-- Instagram Icons -->
      <div class="flex items-center gap-6">
        {
          settings.instagram_url && (
            <div class="tt-social-icon-wrapper flex flex-col items-center gap-2">
              <a
                target="_blank"
                href={settings.instagram_url}
                aria-label="Instagram Malinki Agence"
                class="block w-[48px] h-[48px] lg:w-[56px] lg:h-[56px] rounded-xl overflow-hidden"
              >
                <img
                  src="/agence-malinki-icon.svg"
                  alt="Malinki Agence Instagram"
                  class="w-full h-full object-cover"
                  width={56}
                  height={56}
                />
              </a>
              <span class="font-['Montserrat'] text-[10px] font-medium text-white/60 uppercase tracking-wide">
                @{s.footer_ig_agency}
              </span>
            </div>
          )
        }
        {
          settings.studio_instagram_url && (
            <div class="tt-social-icon-wrapper flex flex-col items-center gap-2">
              <a
                target="_blank"
                href={settings.studio_instagram_url}
                aria-label="Instagram Studio Malinki"
                class="block w-[48px] h-[48px] lg:w-[56px] lg:h-[56px] rounded-xl overflow-hidden"
              >
                <Image
                  src={studioLogo}
                  alt="Studio Malinki Instagram"
                  class="w-full h-full object-cover"
                  width={56}
                  height={56}
                />
              </a>
              <span class="font-['Montserrat'] text-[10px] font-medium text-white/60 uppercase tracking-wide">
                @{s.footer_ig_studio}
              </span>
            </div>
          )
        }
      </div>

      

      <!-- Language Switcher -->
      <div class="flex justify-center lg:justify-end">
        <LanguageSwitcher
          client:load
          currentLang={currentLang}
          currentPath={currentPath}
        />
      </div>

      <!-- Copyright Text -->
      <p
        class="font-['Montserrat'] font-medium text-[16px] leading-[1.2] text-white text-center lg:text-right m-0 whitespace-pre"
      >
        {s.footer_copyright}
      </p>
    </div>
  </div>
</footer>

<style>
  /* Social icon styling */
  .tt-social-icon-wrapper a {
    transition: opacity 0.2s ease;
  }

  .tt-social-icon-wrapper a:hover {
    opacity: 0.8;
  }
</style>
