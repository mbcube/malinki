---
import { useTranslations } from "../i18n/utils";

// Get current language from Astro params
const { lang } = Astro.params;
const currentLang = (lang || "fr") as "fr" | "en";
const t = useTranslations(currentLang);

// Inline settings (migrated from Shopify schema)
const settings = {
  video_url_desktop:
    "https://pub-a83e9e4a4dae446fa7c1797c5d49e07f.r2.dev/hero/hero-video.mp4",
  video_url_mobile:
    "https://pub-a83e9e4a4dae446fa7c1797c5d49e07f.r2.dev/hero/malinki_demo_reel_portrait.mp4",
  poster_desktop:
    "https://pub-a83e9e4a4dae446fa7c1797c5d49e07f.r2.dev/hero/hero-video-poster.jpg",
  poster_mobile:
    "https://pub-a83e9e4a4dae446fa7c1797c5d49e07f.r2.dev/hero/hero-video-poster-mobile.jpg",
  reel_link: "https://vimeo.com/912326021",
  heading: t("general.hero_video.heading"),
  subtitle: t("general.hero_video.subtitle"),
  show_scroll_indicator: true,
};
---

<!-- Hero Video Section -->
<section
  class="relative w-full h-screen flex! items-stretch! justify-center"
  data-section-type="hero-video"
  id="hero-container"
>
  <div
    class="w-full sm:w-auto mx-0 sm:mx-8 mt-12 flex! flex-col! items-center justify-center z-59!!"
    data-hero-video-container
  >
    <div
      data-hero-video-wrapper
      class="relative overflow-hidden z-40 rounded-[8px]! sm:rounded-[12px]! lg:rounded-[24px]! w-full h-[300px] sm:w-[300px] sm:h-[200px] min-w-[300px] min-h-[200px] lg:min-w-[406px] lg:min-h-[252px] xl:min-w-[504px] xl:min-h-[284px] shadow-2xl"
      style="container-type: inline-size;"
    >
      <video
        class="w-full h-full object-cover aspect-4/3"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        poster={settings.poster_desktop}
        data-hero-video
        data-video-desktop={settings.video_url_desktop}
        data-video-mobile={settings.video_url_mobile}
        data-poster-desktop={settings.poster_desktop}
        data-poster-mobile={settings.poster_mobile}
      >
        <source src={settings.video_url_desktop} type="video/mp4" />
        Your browser does not support the video tag.
      </video>

      <!-- Heading and Subtitle inside video wrapper -->
      <div
        class="absolute bottom-0 left-0 right-0 flex items-end justify-between opacity-0 pb-2 ps-1! md:ps-2! lg:ps-4! pe-1! md:pe-2! lg:pe-4!"
        data-hero-heading
      >
        <div
          class="flex flex-col items-start gap-0 text-left w-[75%] max-w-[300px] md:max-w-[600px] lg:max-w-[800px] xl:max-w-[1000px]"
        >
          <h1
            class="font-['Montserrat']! font-medium! text-white uppercase leading-[1.3]! md:leading-[1.26]! drop-shadow-lg m-0! p-0! text-[6cqw]! sm:text-[3cqw]! lg:text-[4cqw]!"
            set:html={settings.heading}
          />
        </div>

        <!-- Voir le reel link - bottom right -->
        <a
          href={settings.reel_link}
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-end justify-end gap-0"
          data-reel-button
        >
          <svg
            class="text-white w-[10cqw] h-[10cqw] sm:w-[7cqw] sm:h-[7cqw] lg:w-[9cqw] lg:h-[9cqw]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
          <p
            class="font-['Montserrat']! font-semibold! leading-none! text-white text-center whitespace-nowrap m-0! p-0! mb-1! text-[3cqw] sm:text-[1.5cqw] lg:text-[2cqw]"
          >
            {t("general.hero_video.view_reel")}
          </p>
        </a>
      </div>
    </div>
  </div>

  {
    settings.show_scroll_indicator && (
      <div class="absolute bottom-4">
        <div
          class="flex flex-col items-center gap-2 animate-bounce pointer-events-none"
          data-hero-scroll-indicator
        >
          <p class="font-medium text-[#083D45] text-xs md:text-sm lg:text-base xl:text-lg font-['Montserrat']!">
            {t("general.hero_video.scroll_indicator_text")}
          </p>
          <svg
            class="w-3 h-3 md:w-4 md:h-4 lg:w-5 lg:h-5 xl:w-6 xl:h-6 text-[#083D45]"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 14l-7 7m0 0l-7-7m7 7V3"
            />
          </svg>
        </div>
      </div>
    )
  }
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  // Register ScrollTrigger plugin
  gsap.registerPlugin(ScrollTrigger);

  // // Disable browser scroll restoration to prevent flash
  // if ("scrollRestoration" in history) {
  //     history.scrollRestoration = "manual";
  // }

  // Store scroll position before page unload
  // let savedScrollPosition: number | null = null;
  // if (sessionStorage.getItem("scrollPosition")) {
  //     savedScrollPosition = parseInt(
  //         sessionStorage.getItem("scrollPosition")!,
  //         10,
  //     );
  // }

  // Save scroll position before navigating away
  // window.addEventListener("beforeunload", function () {
  //     sessionStorage.setItem(
  //         "scrollPosition",
  //         String(window.pageYOffset || document.documentElement.scrollTop),
  //     );
  // });

  document.addEventListener("DOMContentLoaded", function () {
    let resizeTimeout: number;

    // Function to update video source based on screen size
    function updateVideoSource() {
      const video = document.querySelector(
        "[data-hero-video]",
      ) as HTMLVideoElement;
      if (!video) return;

      const isMobile = window.innerWidth < 640;
      const desktopUrl = video.dataset.videoDesktop;
      const mobileUrl = video.dataset.videoMobile;
      const desktopPoster = video.dataset.posterDesktop;
      const mobilePoster = video.dataset.posterMobile;

      if (!desktopUrl || !mobileUrl) return;

      const currentSrc = video.querySelector("source")?.src;
      const targetUrl = isMobile ? mobileUrl : desktopUrl;
      const targetPoster = isMobile ? mobilePoster : desktopPoster;

      // Only update if the source needs to change
      if (currentSrc && !currentSrc.endsWith(targetUrl.split("/").pop()!)) {
        const currentTime = video.currentTime;
        const source = video.querySelector("source");
        if (source && targetPoster) {
          source.src = targetUrl;
          video.poster = targetPoster;
          video.load();
          video.currentTime = currentTime;
          video.play().catch(() => {
            // Video play was prevented, likely due to autoplay policies
          });
        }
      }
    }

    // Flag to track if animation has played (persists until page reload)
    let hasAnimated = false;
    let isAnimating = false;
    let scrollBlocked = true; // Block scroll initially

    // Function to prevent all scrolling
    function preventScroll(e: Event) {
      e.preventDefault();
      e.stopPropagation();
      return false;
    }

    // Initialize hero video animation
    function initHeroVideoAnimation() {
      const videoWrapper = document.querySelector(
        "[data-hero-video-wrapper]",
      ) as HTMLElement;
      const videoContainer = document.querySelector(
        "[data-hero-video-container]",
      ) as HTMLElement;
      const heroSection = document.querySelector(
        '[data-section-type="hero-video"]',
      ) as HTMLElement;
      const scrollIndicator = document.querySelector(
        "[data-hero-scroll-indicator]",
      ) as HTMLElement;
      const heading = document.querySelector(
        "[data-hero-heading]",
      ) as HTMLElement;

      if (!videoWrapper || !videoContainer || !heroSection) return;

      // Skip animation if:
      // - page loaded with a hash anchor (browser will auto-scroll, hero won't be visible)
      // - page loaded with a non-zero scroll position (already scrolled past hero)
      if (window.location.hash !== "" || window.scrollY > 0) {
        hasAnimated = true;
        if (heading) gsap.set(heading, { opacity: 1 });
        if (scrollIndicator) gsap.set(scrollIndicator, { opacity: 0 });

        const windowWidth = window.innerWidth;
        const windowHeight = window.innerHeight;
        const isMobile = windowWidth < 640;

        if (isMobile) {
          gsap.set(videoWrapper, { height: windowHeight * 0.9 });
        } else {
          let initialWidth: number, initialHeight: number;
          if (windowWidth >= 1280) {
            initialWidth = 504;
            initialHeight = 284;
          } else if (windowWidth >= 1024) {
            initialWidth = 406;
            initialHeight = 252;
          } else {
            initialWidth = 300;
            initialHeight = 200;
          }
          const aspectRatio = initialWidth / initialHeight;
          const maxWidth = windowWidth - 64;
          const maxHeight = windowHeight * 0.9;
          let targetWidth = maxWidth;
          let targetHeight = targetWidth / aspectRatio;
          if (targetHeight > maxHeight) {
            targetHeight = maxHeight;
            targetWidth = targetHeight * aspectRatio;
          }
          gsap.set(videoWrapper, { width: targetWidth, height: targetHeight });
        }

        return;
      }

      // Kill existing ScrollTriggers for this section
      ScrollTrigger.getAll().forEach((trigger) => {
        if (
          trigger.trigger === heroSection ||
          trigger.trigger === videoWrapper
        ) {
          trigger.kill();
        }
      });

      // Function to trigger the one-time animation
      function triggerVideoAnimation() {
        if (hasAnimated || isAnimating) return;

        hasAnimated = true;
        isAnimating = true;

        // Lock scrolling during animation to ensure user sees complete animation
        const scrollY = window.scrollY;
        document.body.style.overflow = "hidden";
        document.body.style.position = "fixed";
        document.body.style.top = `-${scrollY}px`;
        document.body.style.width = "100%";

        // Keep blocking scroll events during animation
        scrollBlocked = true;

        const windowWidth = window.innerWidth;
        const windowHeight = window.innerHeight;
        const isMobile = windowWidth < 640;

        let targetHeight: number, targetWidth: number;

        if (isMobile) {
          // Mobile: Keep full width, only grow in height
          targetHeight = windowHeight * 0.9; // Grow to 90% of viewport height

          // Create animation timeline
          const tl = gsap.timeline({
            onComplete: () => {
              isAnimating = false;

              // Unlock scrolling after animation completes
              document.body.style.overflow = "";
              document.body.style.position = "";
              document.body.style.top = "";
              document.body.style.width = "";
              window.scrollTo(0, scrollY);

              // Allow scrolling again
              scrollBlocked = false;
              removeScrollBlockers();
            },
          });

          // Animate video wrapper
          tl.to(
            videoWrapper,
            {
              height: targetHeight,
              duration: 0.7,
              ease: "power2.out",
            },
            0,
          );

          // Fade in heading
          tl.to(
            heading,
            {
              opacity: 1,
              duration: 0.7,
              ease: "linear",
            },
            0,
          );

          // Fade out scroll indicator
          if (scrollIndicator) {
            tl.to(
              scrollIndicator,
              {
                opacity: 0,
                duration: 0.3,
                ease: "power2.out",
              },
              0,
            );
          }
        } else {
          // Desktop/Tablet: Grow in width and height
          let initialWidth: number, initialHeight: number;

          if (windowWidth >= 1280) {
            initialWidth = 504;
            initialHeight = 284;
          } else if (windowWidth >= 1024) {
            initialWidth = 406;
            initialHeight = 252;
          } else {
            initialWidth = 300;
            initialHeight = 200;
          }

          // Calculate aspect ratio from initial dimensions
          const aspectRatio = initialWidth / initialHeight;

          // Calculate maximum available space with padding
          const maxWidth = windowWidth - 64; // 64px total padding on desktop
          const maxHeight = windowHeight * 0.9; // Use 90% of viewport height

          // Determine target dimensions based on available space and aspect ratio
          targetWidth = maxWidth;
          targetHeight = targetWidth / aspectRatio;

          // If height exceeds max, constrain by height instead
          if (targetHeight > maxHeight) {
            targetHeight = maxHeight;
            targetWidth = targetHeight * aspectRatio;
          }

          // Create animation timeline
          const tl = gsap.timeline({
            onComplete: () => {
              isAnimating = false;

              // Unlock scrolling after animation completes
              document.body.style.overflow = "";
              document.body.style.position = "";
              document.body.style.top = "";
              document.body.style.width = "";
              window.scrollTo(0, scrollY);

              // Allow scrolling again
              scrollBlocked = false;
              removeScrollBlockers();
            },
          });

          // Animate the video wrapper to grow using width and height
          tl.to(
            videoWrapper,
            {
              width: targetWidth,
              height: targetHeight,
              duration: 0.7,
              ease: "power2.out",
            },
            0,
          );

          // Fade in heading
          tl.to(
            heading,
            {
              opacity: 1,
              duration: 0.7,
              ease: "linear",
            },
            0,
          );

          // Fade out scroll indicator
          if (scrollIndicator) {
            tl.to(
              scrollIndicator,
              {
                opacity: 0,
                duration: 0.3,
                ease: "power2.out",
              },
              0,
            );
          }
        }
      }

      // Add scroll blocker event listeners
      function addScrollBlockers() {
        // Block wheel events (mouse wheel, trackpad)
        window.addEventListener("wheel", preventScroll, { passive: false });
        // Block touch events (mobile scrolling)
        window.addEventListener("touchmove", preventScroll, {
          passive: false,
        });
        // Block keyboard scrolling (spacebar, arrow keys, page up/down)
        window.addEventListener("keydown", preventScrollKeys, false);
      }

      // Remove scroll blocker event listeners
      function removeScrollBlockers() {
        window.removeEventListener("wheel", preventScroll);
        window.removeEventListener("touchmove", preventScroll);
        window.removeEventListener("keydown", preventScrollKeys);
      }

      // Prevent scrolling via keyboard
      function preventScrollKeys(e: KeyboardEvent) {
        const keys = [32, 33, 34, 35, 36, 37, 38, 39, 40]; // spacebar, page up/down, home, end, arrows
        if (keys.includes(e.keyCode)) {
          preventScroll(e);
          return false;
        }
      }

      // Handle first scroll attempt - trigger animation
      function handleFirstScrollAttempt(e: Event) {
        if (!hasAnimated && !isAnimating) {
          // Prevent the scroll that triggered this
          e.preventDefault();
          e.stopPropagation();

          // Trigger the animation
          triggerVideoAnimation();
        }
      }

      // Listen for first scroll attempt (wheel, touch, or keyboard)
      window.addEventListener("wheel", handleFirstScrollAttempt, {
        passive: false,
        once: true,
      });
      window.addEventListener("touchmove", handleFirstScrollAttempt, {
        passive: false,
        once: true,
      });
      window.addEventListener(
        "keydown",
        (e) => {
          const keys = [32, 33, 34, 35, 36, 37, 38, 39, 40];
          if (keys.includes(e.keyCode)) {
            handleFirstScrollAttempt(e);
          }
        },
        { once: true },
      );

      // Block all scrolling initially
      addScrollBlockers();
    }

    // Initialize on page load
    updateVideoSource();
    initHeroVideoAnimation();

    // Debounced resize handler to update video source and adjust dimensions if already animated
    window.addEventListener("resize", function () {
      clearTimeout(resizeTimeout);
      resizeTimeout = window.setTimeout(function () {
        updateVideoSource();

        // If animation has already played, update dimensions to match new viewport
        if (hasAnimated) {
          const videoWrapper = document.querySelector(
            "[data-hero-video-wrapper]",
          ) as HTMLElement;

          if (!videoWrapper) return;

          const windowWidth = window.innerWidth;
          const windowHeight = window.innerHeight;
          const isMobile = windowWidth < 640;

          if (isMobile) {
            // Mobile: Update height to match new viewport
            gsap.set(videoWrapper, {
              height: windowHeight * 0.9,
            });
          } else {
            // Desktop/Tablet: Recalculate dimensions
            let initialWidth: number, initialHeight: number;

            if (windowWidth >= 1280) {
              initialWidth = 504;
              initialHeight = 284;
            } else if (windowWidth >= 1024) {
              initialWidth = 406;
              initialHeight = 252;
            } else {
              initialWidth = 300;
              initialHeight = 200;
            }

            const aspectRatio = initialWidth / initialHeight;
            const maxWidth = windowWidth - 64;
            const maxHeight = windowHeight * 0.9;

            let targetWidth = maxWidth;
            let targetHeight = targetWidth / aspectRatio;

            if (targetHeight > maxHeight) {
              targetHeight = maxHeight;
              targetWidth = targetHeight * aspectRatio;
            }

            gsap.set(videoWrapper, {
              width: targetWidth,
              height: targetHeight,
            });
          }
        } else {
          // If animation hasn't played yet, reinitialize
          initHeroVideoAnimation();
        }
      }, 250); // Wait 250ms after resize stops before updating
    });
  });
</script>
