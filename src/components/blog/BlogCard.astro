---
import { Image } from "astro:assets";
import { formatPublishedAt, toIsoDate } from "@/lib/blog";

interface Props {
  slug: string;
  title: string;
  excerpt: string;
  coverImage?: string;
  coverImageAlt?: string;
  publishedAt?: string;
  categoryLabel?: string | null;
  lang: "fr" | "en";
}

const {
  slug,
  title,
  excerpt,
  coverImage,
  coverImageAlt,
  publishedAt,
  categoryLabel,
  lang,
} = Astro.props;

const postUrl = lang === "en" ? `/en/blog/${slug}` : `/blog/${slug}`;
const formattedDate = formatPublishedAt(publishedAt, lang);
const isoDate = toIsoDate(publishedAt);
const imageAlt = coverImageAlt?.trim() || title;
---

<a
  href={postUrl}
  class="group flex h-full flex-col rounded-[24px] overflow-hidden bg-white transition-all duration-300 ease-out hover:-translate-y-1.5 hover:shadow-xl"
>
  <div class="relative w-full aspect-[3/2] overflow-hidden">
    {
      coverImage ? (
        <Image
          src={coverImage}
          alt={imageAlt}
          class="w-full h-full object-cover transition-transform duration-300 ease-out group-hover:scale-105"
          width={1200}
          height={800}
          loading="lazy"
        />
      ) : (
        <div class="w-full h-full bg-[#083D45]/10" />
      )
    }
    <div
      class="absolute inset-0 bg-gradient-to-t from-[#083D45]/25 via-transparent to-transparent opacity-0 transition-opacity duration-300 ease-out group-hover:opacity-100"
    />
  </div>
  <div class="flex flex-1 flex-col gap-2 p-6 lg:p-7">
    {
      categoryLabel && (
        <p class="font-['Montserrat'] text-[12px] font-semibold leading-[1.2] text-[#083D45]/70 uppercase">
          {categoryLabel}
        </p>
      )
    }
    {
      formattedDate && (
        <p class="font-['Montserrat'] text-[12px] font-medium leading-[1.2] text-[#083D45]/60 uppercase">
          <time datetime={isoDate || undefined}>{formattedDate}</time>
        </p>
      )
    }
    <h2
      class="font-['Montserrat'] text-[20px] md:text-[24px] font-bold leading-none uppercase text-[#083D45] transition-colors duration-300 ease-out group-hover:text-[#0a4d57] line-clamp-2"
    >
      {title}
      <span
        class="mt-2 block h-[2px] w-0 bg-[#083D45] transition-all duration-300 ease-out group-hover:w-10"
      />
    </h2>
    <p
      class="font-['Montserrat'] text-[16px] font-medium leading-[1.2] text-[#083D45]/80 line-clamp-3"
    >
      {excerpt}
    </p>
  </div>
</a>
