---
import { getEntry, getCollection } from "astro:content";
import BlogCard from "@/components/blog/BlogCard.astro";
import BlogFilterBar from "@/components/blog/BlogFilterBar.astro";
import { getCategoryLabel } from "@/lib/blog";

interface BlogPost {
  slug: string;
  title: string;
  excerpt: string;
  coverImage?: string;
  publishedAt?: string;
  category?: string;
}

interface Props {
  posts: BlogPost[];
  lang: "fr" | "en";
}

const { posts, lang } = Astro.props;
const { data: bp } = await getEntry("blog-page", lang);

const categories = (await getCollection("blog-categories")).map((c) => c.data);

const contactUrl = `/${lang === "fr" ? "" : "en/"}contact`;
const allLabel = lang === "fr" ? "Tous" : "All";
---

<section class="w-full px-6 lg:px-10 pb-20 lg:pb-28">
  {
    posts.length > 0 ? (
      <>
        <BlogFilterBar categories={categories} lang={lang} allLabel={allLabel} />
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map((post) => (
            <BlogCard
              slug={post.slug}
              title={post.title}
              excerpt={post.excerpt}
              coverImage={post.coverImage}
              publishedAt={post.publishedAt}
              category={post.category}
              categoryLabel={getCategoryLabel(categories, post.category, lang)}
              lang={lang}
            />
          ))}
        </div>
        <div
          data-blog-empty-state
          class="flex-col items-center justify-center gap-6 w-full py-20 lg:py-28 border border-[#083D45]/15 rounded-[24px] text-center mt-6"
          style="display: none;"
        >
          <h2 class="font-['Montserrat'] text-[28px] md:text-[36px] font-bold leading-none uppercase text-[#083D45]">
            {bp.empty_state_title}
          </h2>
          <p class="font-['Montserrat'] text-[16px] md:text-[18px] font-medium leading-[1.2] text-[#083D45]/80 max-w-[480px]">
            {bp.empty_state_text}
          </p>
        </div>
      </>
    ) : (
      <div class="flex flex-col items-center justify-center gap-6 w-full py-20 lg:py-28 border border-[#083D45]/15 rounded-[24px] text-center">
        <h2 class="font-['Montserrat'] text-[28px] md:text-[36px] font-bold leading-none uppercase text-[#083D45]">
          {bp.empty_state_title}
        </h2>
        <p class="font-['Montserrat'] text-[16px] md:text-[18px] font-medium leading-[1.2] text-[#083D45]/80 max-w-[480px]">
          {bp.empty_state_text}
        </p>
        <a
          href={contactUrl}
          class="inline-flex items-center justify-center px-6 py-[14px] sm:px-7 sm:py-4 font-['Montserrat'] text-sm md:text-base font-semibold leading-normal no-underline whitespace-nowrap cursor-pointer transition-all duration-200 ease-in-out hover:-translate-y-0.5 hover:shadow-lg bg-[#083D45] text-white rounded-[8px] hover:bg-[#0a4d57]"
        >
          {bp.cta_text}
        </a>
      </div>
    )
  }
</section>
