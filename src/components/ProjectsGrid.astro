---
import ProjectCard from "./ProjectCard.astro";
import projectsGrid from "../data/projects-grid.json";

interface Props {
  lang?: "fr" | "en";
}

const { lang = "fr" } = Astro.props;
const { grids } = projectsGrid;
---

<!-- Projects Grid Section -->
<section
  class="relative w-full font-['Montserrat'] mt-12 md:mt-16 lg:mt-20 mb-3"
  data-section-type="projects-grid"
  id="projects"
>
  <div>
    {
      grids.map((grid) => (
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 auto-rows-fr mb-3">
          {grid.projects.map((project) => (
            <ProjectCard
              imageFile={project.imageFile}
              videoUrl={project.videoUrl}
              altText={project.altText}
              clientName={project.clientName}
              agencyName={project.agencyName}
              width={project.width}
              height={project.height}
              containerClasses={project.containerClasses}
              projectSlug={project.projectSlug}
              tagText={project.tagText}
              lang={lang}
            />
          ))}
        </div>
      ))
    }
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    // Get all project cards with video
    const projectCards = document.querySelectorAll("[data-project-card]");

    // Mobile detection utility
    const isMobile = () => {
      const hasTouchScreen =
        "ontouchstart" in window || navigator.maxTouchPoints > 0;
      const isSmallScreen = window.innerWidth < 768;
      return hasTouchScreen && isSmallScreen;
    };

    // Video data map to store start times and state
    const videoDataMap = new Map<
      HTMLVideoElement,
      {
        startTime: number;
        card: Element;
        isVisible: boolean;
        isHovered: boolean;
      }
    >();

    // Setup video data and hover listeners
    projectCards.forEach((card) => {
      const video = card.querySelector(
        "[data-video-hover]",
      ) as HTMLVideoElement;

      if (video) {
        // Extract start time from data attribute (original URL with time fragment)
        const originalUrl = video.getAttribute("data-video-url");
        let startTime = 0;

        if (originalUrl && originalUrl.includes("#t=")) {
          const timeFragment = originalUrl.split("#t=")[1];
          // Handle formats like "10" (seconds) or "1:30" (minutes:seconds)
          if (timeFragment.includes(":")) {
            const parts = timeFragment.split(":");
            startTime = parseInt(parts[0]) * 60 + parseFloat(parts[1]);
          } else {
            startTime = parseFloat(timeFragment);
          }
        }

        // Store video data
        videoDataMap.set(video, {
          startTime,
          card,
          isVisible: false,
          isHovered: false,
        });

        // Preload metadata to prevent jump on first hover
        video.load();

        // Desktop: Play video on hover (only if not mobile)
        card.addEventListener("mouseenter", function () {
          if (isMobile()) return; // Skip hover behavior on mobile

          const data = videoDataMap.get(video);
          if (data) {
            data.isHovered = true;
          }

          video.currentTime = startTime;
          const playPromise = video.play();

          if (playPromise !== undefined) {
            playPromise.catch((error) => {
              console.log("Video autoplay prevented:", error);
            });
          }
        });

        // Desktop: Pause and reset video when hover ends
        card.addEventListener("mouseleave", function () {
          if (isMobile()) return; // Skip hover behavior on mobile

          const data = videoDataMap.get(video);
          if (data) {
            data.isHovered = false;
          }

          video.pause();
          video.currentTime = startTime;
          video.load();
        });
      }
    });

    // Mobile-specific scroll-pause video playback
    if (isMobile()) {
      let scrollTimeout: number | null = null;
      let currentlyPlayingVideo: HTMLVideoElement | null = null;

      // Set up IntersectionObserver for 80% visibility tracking
      const observerOptions = {
        root: null,
        rootMargin: "0px",
        threshold: 0.8, // 80% visibility required
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;
          const data = videoDataMap.get(video);

          if (data) {
            data.isVisible =
              entry.isIntersecting && entry.intersectionRatio >= 0.8;

            // If video is no longer visible and it's playing, pause it
            if (!data.isVisible && video === currentlyPlayingVideo) {
              video.pause();
              video.currentTime = data.startTime;
              video.load();
              currentlyPlayingVideo = null;
            }
          }
        });
      }, observerOptions);

      // Observe all videos
      videoDataMap.forEach((data, video) => {
        observer.observe(video);
      });

      // Find the most centered visible video
      const findMostCenteredVideo = (): HTMLVideoElement | null => {
        const visibleVideos: Array<{
          video: HTMLVideoElement;
          distance: number;
        }> = [];
        const viewportCenter = window.innerHeight / 2;

        videoDataMap.forEach((data, video) => {
          if (data.isVisible) {
            const rect = video.getBoundingClientRect();
            const videoCenter = rect.top + rect.height / 2;
            const distanceFromCenter = Math.abs(viewportCenter - videoCenter);

            visibleVideos.push({ video, distance: distanceFromCenter });
          }
        });

        if (visibleVideos.length === 0) return null;

        // Sort by distance and return the closest to center
        visibleVideos.sort((a, b) => a.distance - b.distance);
        return visibleVideos[0].video;
      };

      // Play the most centered video
      const playMostCenteredVideo = () => {
        const targetVideo = findMostCenteredVideo();

        // If no video is visible or the same video is already playing, do nothing
        if (!targetVideo || targetVideo === currentlyPlayingVideo) {
          return;
        }

        // Pause currently playing video if different
        if (currentlyPlayingVideo && currentlyPlayingVideo !== targetVideo) {
          const currentData = videoDataMap.get(currentlyPlayingVideo);
          if (currentData) {
            currentlyPlayingVideo.pause();
            currentlyPlayingVideo.currentTime = currentData.startTime;
            currentlyPlayingVideo.load();
          }
        }

        // Play the new target video
        const targetData = videoDataMap.get(targetVideo);
        if (targetData) {
          targetVideo.currentTime = targetData.startTime;
          const playPromise = targetVideo.play();

          if (playPromise !== undefined) {
            playPromise
              .then(() => {
                currentlyPlayingVideo = targetVideo;
              })
              .catch((error) => {
                console.log("Video autoplay prevented:", error);
              });
          }
        }
      };

      // Scroll event listener with debounce
      const handleScroll = () => {
        // Clear existing timeout
        if (scrollTimeout !== null) {
          clearTimeout(scrollTimeout);
        }

        // Set new timeout - triggers after 300ms of no scrolling
        scrollTimeout = window.setTimeout(() => {
          playMostCenteredVideo();
        }, 300);
      };

      // Add scroll listener
      window.addEventListener("scroll", handleScroll, { passive: true });

      // Also check on load in case a video is already in view
      setTimeout(() => {
        playMostCenteredVideo();
      }, 500);
    }
  });
</script>
