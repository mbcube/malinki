---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../images/**/*.{jpg,jpeg,png,webp,gif,svg}",
  { eager: true }
);

const imageMap: Record<string, ImageMetadata> = Object.fromEntries(
  Object.entries(modules).map(([path, mod]) => [path.split("/").pop()!, mod.default])
);

interface Props {
  imageFile: string;
  videoUrl?: string;
  altText: string;
  clientName: string;
  agencyName: string;
  tagText?: {
    fr: string;
    en: string;
  };
  width: number;
  height: number;
  containerClasses?: string;
  projectSlug?: string;
  lang?: "fr" | "en";
}

const {
  imageFile,
  videoUrl,
  altText,
  clientName,
  agencyName,
  tagText,
  width,
  height,
  containerClasses = "",
  projectSlug,
  lang = "fr" as "fr" | "en",
} = Astro.props;

// Build project URL with language support
const projectUrl = projectSlug
  ? lang === "en"
    ? `/en/projects/${projectSlug}`
    : `/projects/${projectSlug}`
  : null;

const imageSrc = imageMap[imageFile];
// Scale up dimensions for better quality (3x for all images)
const scaledWidth = width * 3;
const scaledHeight = height * 3;
const posterImage = imageSrc
  ? await getImage({ src: imageSrc, width: scaledWidth, height: scaledHeight })
  : null;

// Remove time fragment from video URL to preserve poster image
// The JavaScript will parse the original URL from data attribute
const cleanVideoUrl = videoUrl ? videoUrl.split("#")[0] : null;

// Common container classes
const containerClass = `group relative overflow-hidden rounded-[24px] sm:rounded-[32px] lg:rounded-[48px] cursor-pointer ${containerClasses}`;

// Define wrapper element
const WrapperElement = projectUrl ? "a" : "div";
const wrapperProps = projectUrl
  ? { href: projectUrl, class: `${containerClass} block` }
  : { class: containerClass };
---

<!-- ProjectCard Component -->
<WrapperElement {...wrapperProps} data-project-card>
  {
    cleanVideoUrl ? (
      <video
        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105 block z-10 aspect-auto"
        style={`aspect-ratio: ${width} / ${height};`}
        poster={posterImage?.src}
        preload="none"
        muted
        loop
        playsinline
        width={width}
        height={height}
        data-video-hover
        data-video-url={videoUrl}
        data-video-src={cleanVideoUrl}
      >
      </video>
    ) : imageSrc ? (
      <Image
        src={imageSrc}
        alt={altText}
        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105 z-20"
        width={scaledWidth}
        height={scaledHeight}
        loading="lazy"
      />
    ) : null
  }

  <!-- Overlay content (visible on hover on desktop, visible by default on mobile, hidden when video is playing) -->
  <div
    class="absolute inset-0 opacity-100 sm:opacity-0 sm:group-hover:opacity-100 transition-opacity duration-300"
    data-overlay
  >
    <!-- Tag at top left -->
    <div
      class="absolute top-6 left-6 bg-white rounded-[32px] px-3 py-3 flex items-center justify-center"
    >
      <p
        class="font-['Montserrat'] font-bold text-[16px] sm:text-[10px] md:text-[14px] lg:text-[16px] text-[#083d45] uppercase leading-none m-0"
      >
        {tagText?.[lang]}
      </p>
    </div>

    <!-- Bottom gradient overlay -->
    <div
      class="absolute bottom-0 left-0 right-0 h-[172px] bg-gradient-to-t from-[rgba(1,12,18,0.7)] via-[rgba(1,12,18,0.4)] to-transparent"
    >
    </div>

    <!-- Client and agency info at bottom left -->
    <div class="absolute bottom-6 left-6 flex flex-col gap-2 text-white">
      <p
        class="font-['Montserrat'] font-bold text-[20px] sm:text-[12px] md:text-[14px] lg:text-[24px] xl:text-[32px] uppercase leading-none"
      >
        {clientName}
      </p>
      <p
        class="font-['Montserrat'] font-medium text-[14px] sm:text-[10px] md:text-[12px] lg:text-[16px] leading-[1.2]"
      >
        {agencyName}
      </p>
    </div>
  </div>
</WrapperElement>
