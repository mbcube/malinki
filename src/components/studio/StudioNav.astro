---
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const navItems = [
  { label: t("studio.nav.le_studio"), href: "#le-studio" },
  { label: t("studio.nav.galerie_photo"), href: "#galerie-photo" },
  { label: t("studio.nav.nos_equipements"), href: "#nos-equipements" },
  { label: t("studio.nav.les_tarifs"), href: "#les-tarifs" },
];
---

<nav class="w-full px-4 pb-8 border-none border-image-none">
  <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3">
    {navItems.map((item) => (
      <li>
        <a
          href={item.href}
          class="flex items-center justify-between w-full px-6 py-5 rounded-2xl bg-[#E6F5F7] text-[#083D45] text-[1rem] font-medium leading-none hover:bg-white transition-colors duration-200 group"
        >
          <span>{item.label}</span>
          <span class="text-[1.25rem] transition-transform duration-200 group-hover:translate-x-1">→</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
