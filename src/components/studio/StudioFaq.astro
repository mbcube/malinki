---
import { getEntry } from "astro:content";
import StudioFaqAccordion from "@/components/studio/islands/StudioFaqAccordion";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const { data: st } = await getEntry("studio", lang);

const faqItems = [
  { categoryLabel: st.faq_cat_studio, question: st.faq_q1_question, answer: st.faq_q1_answer },
  { question: st.faq_q2_question, answer: st.faq_q2_answer },
  { categoryLabel: st.faq_cat_reservations, question: st.faq_q3_question, answer: st.faq_q3_answer },
  { question: st.faq_q4_question, answer: st.faq_q4_answer },
  { question: st.faq_q5_question, answer: st.faq_q5_answer },
  { question: st.faq_q6_question, answer: st.faq_q6_answer },
  { categoryLabel: st.faq_cat_installations, question: st.faq_q7_question, answer: st.faq_q7_answer },
  { question: st.faq_q8_question, answer: st.faq_q8_answer },
  { question: st.faq_q9_question, answer: st.faq_q9_answer },
  { categoryLabel: st.faq_cat_services, question: st.faq_q10_question, answer: st.faq_q10_answer },
  { question: st.faq_q11_question, answer: st.faq_q11_answer },
];
---

<section id="faq" class="w-full px-6 md:px-8 py-16 md:py-24">
  <div class="mx-auto w-full ">
    <div class="flex flex-col md:flex-row gap-12 md:gap-16 items-start">

      <!-- Title: stacked on mobile, fixed-width column on desktop -->
      <h2 class="mt-[1.5rem] text-[1.75rem] md:text-[2.25rem] lg:text-[2.75rem] font-bold leading-none uppercase text-white shrink-0 md:w-[18.75rem] lg:w-[28rem]">
        {st.faq_title}
      </h2>

      <!-- Accordion -->
      <div class="w-full min-w-0 flex-1">
        <StudioFaqAccordion client:load items={faqItems} />
      </div>

    </div>
  </div>
</section>
