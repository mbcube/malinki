---
import { useTranslations } from "@/i18n/utils";
import StudioFaqAccordion from "@/components/studio/islands/StudioFaqAccordion";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const faqItems = [
  {
    categoryLabel: t("studio.faq.cat_studio") as string,
    question: t("studio.faq.q1_question") as string,
    answer: t("studio.faq.q1_answer"),
  },
  {
    question: t("studio.faq.q2_question") as string,
    answer: t("studio.faq.q2_answer"),
  },
  {
    categoryLabel: t("studio.faq.cat_reservations") as string,
    question: t("studio.faq.q3_question") as string,
    answer: t("studio.faq.q3_answer"),
  },
  {
    question: t("studio.faq.q4_question") as string,
    answer: t("studio.faq.q4_answer"),
  },
  {
    question: t("studio.faq.q5_question") as string,
    answer: t("studio.faq.q5_answer"),
  },
  {
    question: t("studio.faq.q6_question") as string,
    answer: t("studio.faq.q6_answer"),
  },
  {
    categoryLabel: t("studio.faq.cat_installations") as string,
    question: t("studio.faq.q7_question") as string,
    answer: t("studio.faq.q7_answer"),
  },
  {
    question: t("studio.faq.q8_question") as string,
    answer: t("studio.faq.q8_answer"),
  },
  {
    question: t("studio.faq.q9_question") as string,
    answer: t("studio.faq.q9_answer"),
  },
  {
    categoryLabel: t("studio.faq.cat_services") as string,
    question: t("studio.faq.q10_question") as string,
    answer: t("studio.faq.q10_answer"),
  },
  {
    question: t("studio.faq.q11_question") as string,
    answer: t("studio.faq.q11_answer"),
  },
];
---

<section id="faq" class="w-full px-6 md:px-8 py-16 md:py-24">
  <div class="mx-auto w-full ">
    <div class="flex flex-col md:flex-row gap-12 md:gap-16 items-start">

      <!-- Title: stacked on mobile, fixed-width column on desktop -->
      <h2 class="mt-[1.5rem] text-[1.75rem] md:text-[2.25rem] lg:text-[2.75rem] font-bold leading-none uppercase text-white shrink-0 md:w-[18.75rem] lg:w-[28rem]">
        {t("studio.faq.title")}
      </h2>

      <!-- Accordion -->
      <div class="w-full min-w-0 flex-1">
        <StudioFaqAccordion client:load items={faqItems} />
      </div>

    </div>
  </div>
</section>
