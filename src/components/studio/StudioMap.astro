---
import { getEntry } from "astro:content";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const { data: st } = await getEntry("studio", lang);
---

<section class="w-full px-8 py-12">
  <div class="relative rounded-[2rem] overflow-hidden min-h-[37.5rem]">

    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1257.839662700261!2d-73.58380649157029!3d45.53931160052874!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xabe0cdcd07a4cced%3A0x5c928aafe9f68c3c!2sAgence%20de%20production%20Malinki!5e0!3m2!1sen!2sca!4v1772342080502!5m2!1sen!2sca"
      class="absolute inset-0 w-full h-full border-0"
      allowfullscreen
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title={st.map_title}
    ></iframe>

    <div class="relative z-10 p-4 lg:p-8 flex items-end lg:items-stretch lg:justify-end min-h-[37.5rem]">
      <div class="bg-[#083D45] rounded-[1.5rem] lg:rounded-[2rem] p-8 flex flex-col gap-8 lg:gap-0 lg:justify-between w-full lg:w-[26.25rem]">
        <div class="flex flex-col gap-4">
          <h2 class="text-[1.75rem] md:text-[2.25rem] lg:text-[2.75rem] font-bold leading-none uppercase text-white">
            {st.map_title}
          </h2>
          <p class="text-[1rem] font-medium leading-[1.2] text-white">
            {st.map_address}
          </p>
        </div>

        <a
          href="/contact"
          class="text-[1rem] font-semibold leading-none text-[#083D45] bg-white rounded-lg px-8 py-5 text-center hover:bg-white/90 transition-colors"
        >
          {st.map_cta}
        </a>
      </div>
    </div>

  </div>
</section>
