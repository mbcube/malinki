---
import { getEntry } from "astro:content";
import StudioPricingCards from "@/components/studio/islands/StudioPricingCards";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const { data: st } = await getEntry("studio", lang);

const contactHref = `/${lang === "en" ? "en/" : ""}contact`;

const cards = [
  {
    title: st.pricing_plan_4h_title,
    price: st.pricing_plan_4h_price,
    ctaLabel: st.pricing_book_now,
  },
  {
    title: st.pricing_plan_8h_title,
    price: st.pricing_plan_8h_price,
    ctaLabel: st.pricing_book_now,
  },
  {
    title: st.pricing_plan_creative_title,
    description: st.pricing_plan_creative_desc,
    ctaLabel: st.pricing_contact_us,
    ctaHref: contactHref,
  },
];
---

<section id="les-tarifs" class="w-full px-6 md:px-8 py-16 md:py-24">
  <div class="mx-auto w-full flex flex-col gap-12 md:gap-16 items-center">

    <!-- Heading -->
    <div class="flex flex-col gap-4 md:gap-6 items-center text-center">
      <h2 class="text-[1.75rem] md:text-[2.25rem] lg:text-[2.75rem] font-bold leading-none uppercase text-white">
        {st.pricing_title}
      </h2>
      <p class="text-[1rem] font-medium leading-[1.2] text-white/80">
        {st.pricing_subtitle}
      </p>
    </div>

    <!-- Cards: carousel on mobile, 3-col grid on desktop -->
    <div class="w-full">
      <StudioPricingCards client:load cards={cards} />
    </div>

  </div>
</section>
