---
import { useTranslations } from "@/i18n/utils";
import StudioPricingCards from "@/components/studio/StudioPricingCards";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const contactHref = `/${lang === "en" ? "en/" : ""}contact`;

const cards = [
  {
    title: t("studio.pricing.plan_4h_title") as string,
    price: t("studio.pricing.plan_4h_price") as string,
    ctaLabel: t("studio.pricing.book_now") as string,
    
  },
  {
    title: t("studio.pricing.plan_8h_title") as string,
    price: t("studio.pricing.plan_8h_price") as string,
    ctaLabel: t("studio.pricing.book_now") as string,
  },
  {
    title: t("studio.pricing.plan_creative_title") as string,
    description: t("studio.pricing.plan_creative_desc") as string,
    ctaLabel: t("studio.pricing.contact_us") as string,
    ctaHref: contactHref,
  },
];
---

<section id="les-tarifs" class="w-full px-6 md:px-8 py-16 md:py-24">
  <div class="mx-auto w-full flex flex-col gap-12 md:gap-16 items-center">

    <!-- Heading -->
    <div class="flex flex-col gap-4 md:gap-6 items-center text-center">
      <h2 class="text-[1.75rem] md:text-[2.25rem] lg:text-[2.75rem] font-bold leading-none uppercase text-white">
        {t("studio.pricing.title")}
      </h2>
      <p class="text-[1rem] font-medium leading-[1.2] text-white/80">
        {t("studio.pricing.subtitle")}
      </p>
    </div>

    <!-- Cards: carousel on mobile, 3-col grid on desktop -->
    <div class="w-full">
      <StudioPricingCards client:load cards={cards} />
    </div>

  </div>
</section>
