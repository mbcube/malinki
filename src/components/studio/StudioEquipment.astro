---
import { getEntry, getCollection } from "astro:content";
import EquipmentDrawer from "@/components/studio/islands/EquipmentDrawer";
import type { EquipmentItem } from "@/components/studio/islands/EquipmentDrawer";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const { data: st } = await getEntry("studio", lang);
const rawEquipment = await getCollection("equipment");

const equipmentData: EquipmentItem[] = rawEquipment.map((item) => ({
  name: String(item.data.name ?? ""),
  qty: String(item.data.qty ?? ""),
  dept: String(item.data.dept ?? ""),
  price: String(item.data.price ?? ""),
  description: String(item.data.description ?? ""),
}));

const available = st.equipment_available;
const rental = st.equipment_rental;
---

<section id="nos-equipements" class="w-full px-6 md:px-8 py-16 md:py-24">
  <div class="mx-auto w-full max-w-[84rem]">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-8">
      <!-- Available equipment -->
      <div>
        <h2
          class="text-[1.75rem] md:text-[2.25rem] lg:text-[2.75rem] font-bold leading-none uppercase text-white mb-6"
        >
          {st.equipment_available_title_line1}<br />
          {st.equipment_available_title_line2}
        </h2>
        <div class="border-t border-white/40">
          {
            available.map((item) => (
              <div class="border-b border-white/40 py-4">
                <p class="text-[1rem] font-medium leading-[1.2] text-white">
                  {item}
                </p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Rental equipment -->
      <div>
        <h2
          class="text-[1.75rem] md:text-[2.25rem] lg:text-[2.75rem] font-bold leading-none uppercase text-white mb-6"
        >
          {st.equipment_rental_title_line1}<br />
          {st.equipment_rental_title_line2}
        </h2>
        <div class="border-t border-white/40">
          {
            rental.map((item) => (
              <div class="border-b border-white/40 py-4">
                <p class="text-[1rem] font-medium leading-[1.2] text-white">
                  {item}
                </p>
              </div>
            ))
          }
          <div class="border-b border-white/40 py-4">
            <EquipmentDrawer
              client:load
              label={st.equipment_view_full_list}
              title={st.equipment_drawer_title}
              colName={st.equipment_col_name}
              colQty={st.equipment_col_qty}
              colDept={st.equipment_col_dept}
              colPrice={st.equipment_col_price}
              colDescription={st.equipment_col_description}
              priceTbd={st.equipment_price_tbd}
              priceNote={st.equipment_price_note}
              filterLabel={st.equipment_filter_dept}
              data={equipmentData}
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
