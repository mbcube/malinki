---
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const available = t("studio.equipment.available") as unknown as string[];
const rental = t("studio.equipment.rental") as unknown as string[];
---

<section id="nos-equipements" class="w-full px-6 md:px-8 py-16 md:py-24">
  <div class="mx-auto w-full max-w-[84rem]">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-8">

      <!-- Available equipment -->
      <div>
        <h2 class="text-[1.75rem] md:text-[2.25rem] lg:text-[2.75rem] font-bold leading-none uppercase text-white mb-6">
          {t("studio.equipment.available_title_line1")}<br />
          {t("studio.equipment.available_title_line2")}
        </h2>
        <div class="border-t border-white/40">
          {available.map((item) => (
            <div class="border-b border-white/40 py-4">
              <p class="text-[1rem] font-medium leading-[1.2] text-white">
                {item}
              </p>
            </div>
          ))}
        </div>
      </div>

      <!-- Rental equipment -->
      <div>
        <h2 class="text-[1.75rem] md:text-[2.25rem] lg:text-[2.75rem] font-bold leading-none uppercase text-white mb-6">
          {t("studio.equipment.rental_title_line1")}<br />
          {t("studio.equipment.rental_title_line2")}
        </h2>
        <div class="border-t border-white/40">
          {rental.map((item) => (
            <div class="border-b border-white/40 py-4">
              <p class="text-[1rem] font-medium leading-[1.2] text-white">
                {item}
              </p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
