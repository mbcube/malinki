---
import { Image } from "astro:assets";
import { useTranslations } from "../i18n/utils";
// SVG imports (raw path)
import operaDeMontreal from "../images/logos/odm.svg?raw";
// PNG imports (for Image component)
import cookIt from "../images/logos/cook-it.svg?raw";
import omy from "../images/logos/omy.svg?raw";
import quartierDesSpectacles from "../images/logos/qds.svg?raw";
import maddle from "../images/logos/Maddle.svg?raw";
import airTransat from "../images/logos/transat.svg?raw";
import stHubert from "../images/logos/st-hubert.svg?raw";
import keywordsStudios from "../images/logos/keywords.svg?raw";
import laval from "../images/logos/Laval.svg?raw";
import veritas from "../images/logos/veritas.svg?raw";
import meatAndProduce from "../images/logos/mnp.svg?raw";
import maisonJeanLapointe from "../images/logos/mjl.svg?raw";
import immobilia from "../images/logos/logo-pur-immobilia.png";
import niche from "../images/logos/niche.svg?raw";
import qolab from "../images/logos/qolab.svg?raw";

const { lang } = Astro.params;
const currentLang = (lang || "fr") as "fr" | "en";
const t = useTranslations(currentLang);

type Logo = {
  alt: string;
} & ({ image: ImageMetadata; svg?: never } | { svg: string; image?: never });

const logos: Logo[] = [
  { svg: operaDeMontreal, alt: "Opéra de Montréal" },
  { svg: cookIt, alt: "Cook it" },
  { svg: omy, alt: "omy LAB" },
  { svg: quartierDesSpectacles, alt: "Quartier des spectacles" },
  { svg: maddle, alt: "Maddle" },
  { svg: airTransat, alt: "Air transat" },
  { svg: stHubert, alt: "St-Hubert" },
  { svg: keywordsStudios, alt: "Keywords Studios" },
  { svg: laval, alt: "Laval" },
  { svg: veritas, alt: "Veritas" },
  { svg: meatAndProduce, alt: "Meat & Produce" },
  { svg: maisonJeanLapointe, alt: "Maison Jean Lapointe" },
  { image: immobilia, alt: "immobilia" },
  { svg: niche, alt: "niche" },
  { svg: qolab, alt: "qolab" },
];
---

<!-- Logos Section -->
<section
  class="relative w-full font-['Montserrat'] py-12 md:py-16 lg:py-20"
  data-section-type="logos-section"
>
  <div class="w-full">
    <!-- Heading -->
    <h2
      class="font-['Montserrat'] text-[28px] md:text-[36px] lg:text-[44px] font-bold leading-none uppercase text-[#083D45] text-center mb-12 md:mb-16 lg:mb-16"
    >
      {t("sections.logos.heading")}
    </h2>

    <!-- Logos Grid -->
    <div class="flex flex-wrap gap-[16px] w-full justify-center">
      {
        logos.map((logo) => (
          <div class="bg-white rounded-[32px] flex items-center justify-center h-[96px] md:h-[136px] p-4 w-[calc((100%-16px)/2)] md:w-[calc((100%-32px)/3)] lg:w-[calc((100%-48px)/4)]">
            {logo.svg ? (
              <Fragment set:html={logo.svg} />
            ) : (
              <Image
                src={logo.image!}
                alt={logo.alt}
                loading="lazy"
                class="max-w-full max-h-full object-contain"
              />
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
